# WandaHost Environment Variables Example
# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=WandaHost
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_PREVIEW=true
NEXT_PUBLIC_ENABLE_MOCK_SERVICES=true

# Future Backend Integrations (Placeholders for real APIs in production)
DOMAIN_REGISTRAR_API_KEY=
DOMAIN_REGISTRAR_ENDPOINT=
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=
SUPPORT_TICKETING_API_KEY=
